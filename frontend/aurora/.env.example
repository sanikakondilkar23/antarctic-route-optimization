# Frontend environment for the SIC integration.
# Copy to `.env.local` and adjust. `.env.local` is git-ignored.

# Absolute origin of the SIC API, used when the frontend is deployed on a
# different host from the backend (e.g. https://sic-api.onrender.com).
# Leave UNSET in development: requests then go to the same origin and Vite
# proxies /api to the backend, which avoids CORS entirely.
# VITE_SIC_API_BASE=https://sic-api.example.com

# Where `npm run dev` / `npm run preview` proxy /api to.
# This is a dev-server setting only; it is never shipped to the browser.
VITE_SIC_API_PROXY_TARGET=http://127.0.0.1:8000
